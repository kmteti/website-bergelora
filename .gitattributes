# Normalisasi semua file teks ke LF di dalam repository (konsisten lintas OS).
# Working directory Windows tetap boleh CRLF, tapi yang tersimpan di Git selalu LF.
* text=auto eol=lf

# File biner: jangan pernah diubah line ending-nya.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary
*.pdf   binary
