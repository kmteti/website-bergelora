# Payload CMS Secret
PAYLOAD_SECRET=your-payload-secret-here

# Database Supabase PostgreSQL
DATABASE_URI=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Supabase S3 Storage
S3_ENDPOINT=https://your-project-ref.storage.supabase.co/storage/v1/s3
S3_REGION=ap-southeast-1
S3_BUCKET=kmteti-bucket
S3_ACCESS_KEY_ID=your-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-s3-secret-access-key

# Google Sheet Form Kontak Sync
KONTAK_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/AKfy...your_script_id.../exec
KONTAK_SHEET_SECRET=your-kontak-sheet-secret-token

# Booklet Partnership URL (halaman /kontak/panduan/[slug])
NEXT_PUBLIC_PARTNERSHIP_BOOKLET_URL=https://your-project-ref.supabase.co/storage/v1/object/public/kmteti-bucket/booklet-partnership-kmteti.pdf
