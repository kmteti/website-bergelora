# ==============================================================================
# WEBSITE BERGELORA KMTETI FT UGM - ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# Petunjuk: Salin file ini menjadi `.env` lalu sesuaikan isinya dengan kredensial
# proyek Anda. Jangan pernah meng-commit file `.env` ke repositori Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PAYLOAD CMS CORE & AUTHENTICATION
# ------------------------------------------------------------------------------
# Secret key acak yang digunakan oleh Payload CMS untuk mengenkripsi JWT auth & session.
# Contoh: string acak minimal 32 karakter.
PAYLOAD_SECRET=your-payload-secret-here

# ------------------------------------------------------------------------------
# 2. DATABASE (SUPABASE POSTGRESQL)
# ------------------------------------------------------------------------------
# Connection string PostgreSQL Supabase menggunakan Supabase Connection Pooler.
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URI=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# ------------------------------------------------------------------------------
# 3. MEDIA STORAGE (SUPABASE STORAGE - S3 COMPATIBLE PROTOCOL)
# ------------------------------------------------------------------------------
# Kredensial S3 API dari project Supabase (Settings -> Storage -> S3 Credentials).
S3_ENDPOINT=https://your-project-ref.storage.supabase.co/storage/v1/s3
S3_REGION=ap-southeast-1
S3_BUCKET=kmteti-bucket
S3_ACCESS_KEY_ID=your-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-s3-secret-access-key

# ------------------------------------------------------------------------------
# 4. FORMULIR KONTAK & SINKRONISASI GOOGLE SHEETS
# ------------------------------------------------------------------------------
# Webhook Google Apps Script penampung data pengajuan formulir kontak eksternal.
KONTAK_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/AKfy...your_script_id.../exec

# Secret key autentikasi webhook (harus sama persis dengan konstanta SECRET di Code.gs).
KONTAK_SHEET_SECRET=your-kontak-sheet-secret-token

# ------------------------------------------------------------------------------
# 5. PUBLIC ASSETS & DOKUMEN EKSTERNAL
# ------------------------------------------------------------------------------
# URL publik file PDF booklet partnership (halaman /kontak/panduan/[slug]).
NEXT_PUBLIC_PARTNERSHIP_BOOKLET_URL=https://your-project-ref.supabase.co/storage/v1/object/public/kmteti-bucket/booklet-partnership-kmteti.pdf
